    end
end)

AddEventHandler('ox_inventory:closeInventory', function()
    if previewObj then
        previewTimer = 0
        deletePreview()
    end
end)

-- ─── first sync with the server ─────────────────────────────
CreateThread(function()
    while not PlayerData or not PlayerData.loaded do Wait(250) end

    for _ = 1, 5 do
        -- ("false": a 3000 ms cooldown made every other retry a silent nil)
        local data = lib.callback.await('ox_inventory:rwDropsSync', false)

        if type(data) == 'table' then
            if type(data.propMap) == 'table' then RWDrops.applyPropMap(data.propMap) end
            RWDrops.applyConfig(data.config, data.enabled)
            return
        end

        Wait(2000)
    end
end)

-- ─── cleanup ────────────────────────────────────────────────
AddEventHandler('onResourceStop', function(resourceName)
    if resourceName ~= cache.resource then return end
    previewTimer = 0
    deletePreview()
    RWDrops.clearAll()
end)

exports('getDropConfig', function() return cfg end)

---Diagnostics (harness): props alive, props reserved by running spawns, active points.
function RWDrops.stats()
    return trackedCount, pendingCount, activeCount
end

return RWDrops
